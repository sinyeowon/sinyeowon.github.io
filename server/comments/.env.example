COMMENTS_DOMAIN=comments.example.com
REMARK_URL=https://comments.example.com
SITE=sinyeowon
SECRET=replace-with-a-long-random-secret
AUTH_ANON=true
AUTH_SAME_SITE=none
AUTH_SEND_JWT_HEADER=true
ADMIN_PASSWD=replace-with-admin-password
TIME_ZONE=Asia/Seoul

ALLOWED_ORIGINS=https://sinyeowon.github.io,http://localhost:4000,http://127.0.0.1:4000
ALLOWED_HOSTS="'self',https://sinyeowon.github.io,http://localhost:4000,http://127.0.0.1:4000"
UPDATE_LIMIT=5
VISITOR_TOTAL_OFFSET=0
VISITOR_TODAY_OFFSET=0
SITE_URL=https://sinyeowon.github.io

# Optional GitHub login for Remark42.
# AUTH_GITHUB_CID=
# AUTH_GITHUB_CSEC=

# Comment and like email notifications.
# Gmail requires an app password, not your normal Google account password.
NOTIFY_ADMINS=email
ADMIN_SHARED_EMAIL=1oohyou@gmail.com
NOTIFY_EMAIL_FROM=1oohyou@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=false
SMTP_STARTTLS=true
SMTP_USERNAME=1oohyou@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password
SMTP_TIMEOUT=10
NOTIFICATION_LIKES=true
NOTIFICATION_EMAIL_TO=1oohyou@gmail.com
NOTIFICATION_EMAIL_FROM=1oohyou@gmail.com

